# localhost, not 127.0.0.1 -- and this matters more than it looks.
#
# The Vite dev server serves the app from http://localhost:5173. Browsers
# treat localhost and 127.0.0.1 as different sites, so pointing the API at
# 127.0.0.1 makes every request cross-site, and dev.py's SameSite=Lax session
# cookie is then withheld. Login appears to work (the user comes back in the
# response body) and the next GET arrives anonymous.
#
# Matching hostnames keeps dev same-site, which is exactly what dev.py's
# cookie settings assume. Production is genuinely cross-origin and uses
# SameSite=None; Secure instead.
VITE_API_URL=http://localhost:8000
