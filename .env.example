# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed -- the brief requires
# connection strings, keys and passwords to live only in the environment.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Neon POOLED connection string (the host containing "-pooler").
# Strip any ?sslmode=... query string; sslmode is set via PGSSLMODE below.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname

# Business day boundary for the dashboard's "today" and "this week" (goal 8).
TIME_ZONE=Asia/Kolkata

# 0 because Neon's pooled endpoint already pools connections.
CONN_MAX_AGE=0
PGSSLMODE=require

# --- Production only (config.settings.prod) ---
ALLOWED_HOSTS=your-api.onrender.com
FRONTEND_ORIGIN=https://your-app.vercel.app
